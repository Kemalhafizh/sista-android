<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_spp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#064E3B"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TAGIHAN SPP BULANAN"
        android:textColor="#FACC15"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_spp_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Agustus 2026: LUNAS"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_spp_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp 850.000 (BSI Virtual Account)"
        android:textColor="#A7F3D0"
        android:textSize="9sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ketuk untuk rincian pembayaran ➔"
        android:textColor="#CBD5E1"
        android:textSize="8.5sp" />

</LinearLayout>
