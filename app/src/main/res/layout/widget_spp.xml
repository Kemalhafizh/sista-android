<?xml version="1.0" encoding="utf-8"?>
<!-- Texts are neutral placeholders; SppWidgetProvider replaces them with the
     cached snapshot (WidgetTextMapper). Never put a sample status such as
     "LUNAS" here: it is what the widget shows until the first render. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_spp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#064E3B"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title_spp"
        android:textColor="#FACC15"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_spp_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_loading"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_spp_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_open_app"
        android:textColor="#A7F3D0"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_spp_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#A7F3D0"
        android:textSize="8.5sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_tap_for_detail"
        android:textColor="#CBD5E1"
        android:textSize="8.5sp" />

</LinearLayout>
