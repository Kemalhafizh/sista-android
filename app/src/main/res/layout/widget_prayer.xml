<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prayer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#064E3B"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JADWAL SALAT SEMARANG"
        android:textColor="#FACC15"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_prayer_next_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Menuju Ashar (15:10)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_prayer_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-01:15:20 lagi"
        android:textColor="#A7F3D0"
        android:textSize="10sp" />

    <!-- Divider. FrameLayout, not a plain View: RemoteViews (home-screen
         widgets) refuses to inflate android.view.View, so the whole widget
         failed to render. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#047857" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Subuh 04:32 • Dzuhur 11:52 • Ashar 15:10 • Maghrib 17:54"
        android:textColor="#CBD5E1"
        android:textSize="9sp" />

</LinearLayout>
