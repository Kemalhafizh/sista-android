<?xml version="1.0" encoding="utf-8"?>
<!-- There is no prayer-time source yet (sistem-terpadu has no JSON API for it,
     see HomeUiState.prayerSchedule), so this widget states that instead of
     showing fixed times. Do not add sample times here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prayer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#064E3B"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title_prayer"
        android:textColor="#FACC15"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_prayer_next_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_prayer_unavailable"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_prayer_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_prayer_no_source"
        android:textColor="#A7F3D0"
        android:textSize="10sp" />

    <!-- Divider. FrameLayout, not a plain View: RemoteViews (home-screen
         widgets) refuses to inflate android.view.View, so the whole widget
         failed to render. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#047857" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_prayer_tap"
        android:textColor="#CBD5E1"
        android:textSize="9sp" />

</LinearLayout>
