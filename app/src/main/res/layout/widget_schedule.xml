<?xml version="1.0" encoding="utf-8"?>
<!-- Texts are neutral placeholders; ScheduleWidgetProvider replaces them with
     today's lessons from the cached snapshot (WidgetTextMapper). Never put
     sample lessons here: they are what the widget shows until the first render. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#064E3B"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title_schedule"
            android:textColor="#FACC15"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_schedule_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_unknown_value"
            android:textColor="#A7F3D0"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Divider. FrameLayout, not a plain View: RemoteViews (home-screen
         widgets) refuses to inflate android.view.View, so the whole widget
         failed to render. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#047857" />

    <TextView
        android:id="@+id/widget_schedule_item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_loading"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_schedule_item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/widget_open_app"
        android:textColor="#E2E8F0"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_schedule_item3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#CBD5E1"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
