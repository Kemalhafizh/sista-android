<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#064E3B"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="JADWAL HARI INI • SMA SA 1"
            android:textColor="#FACC15"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_schedule_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XII MIPA 1"
            android:textColor="#A7F3D0"
            android:textSize="9sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#047857" />

    <TextView
        android:id="@+id/widget_schedule_item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="07:00 - Matematika Peminatan (Lab 2)"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_schedule_item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="08:30 - Fisika Modern (Lab Fisika)"
        android:textColor="#E2E8F0"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_schedule_item3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="10:15 - PAI &amp; Budi Pekerti (Masjid)"
        android:textColor="#CBD5E1"
        android:textSize="10sp" />

</LinearLayout>
