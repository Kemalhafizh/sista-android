<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Declared here because this module's own code needs it; lint checks each
        module against its own manifest. :app already requests it, so the merged
        app manifest is unchanged.
        ConnectivityManager.registerNetworkCallback / activeNetwork / getNetworkCapabilities in core/sync/NetworkConnectivityObserver.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
